# AI Smart Sign Language Glove — Environment Configuration
# Copy this file to .env and edit the values for your setup.
#
# To find your serial port:
#   Windows: Check Device Manager → Ports (COM & LPT)
#   macOS:   Run: ls /dev/cu.usb*
#   Linux:   Run: ls /dev/ttyUSB* or ls /dev/ttyACM*

# Serial port for ESP32 connection
# Examples:
#   Windows: COM3, COM4, COM5, etc.
#   macOS:   /dev/cu.usbserial-0001
#   Linux:   /dev/ttyUSB0
SERIAL_PORT=COM3

# Serial baud rate (must match firmware setting)
SERIAL_BAUD_RATE=115200

# Model file path (relative to project root)
MODEL_PATH=models/gesture_model.joblib

# Dashboard settings
DASHBOARD_PORT=8501

# Data collection settings
DATASET_DIR=dataset
